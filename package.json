{
  "name": "signaldesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "worker": "npm run build:server && node dist/server/worker/index.js",
    "migrate": "npm run build:server && node dist/scripts/migrate.js",
    "seed": "npm run build:server && node dist/scripts/seed.js",
    "build": "vite build --configLoader native && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --configLoader native",
    "test:integration": "vitest run tests/integration --configLoader native --maxWorkers=1",
    "test:browser": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "dev:client": "vite --configLoader native",
    "lint": "eslint client server shared scripts tests *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "embedded-postgres": "^17.6.0-beta.15",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.2.2",
    "vitest": "^5.0.3"
  }
}
